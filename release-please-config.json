{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "bulkhead",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true
    },
    "packages/core": {
      "release-type": "node",
      "component": "bulkhead-core",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/server": {
      "release-type": "node",
      "component": "bulkhead-server",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "group-pull-requests": true,
  "linked-versions": [
    {
      "group": "bulkhead",
      "components": ["bulkhead", "bulkhead-core", "bulkhead-server"]
    }
  ],
  "prerelease-type": "preview",
  "branches": [
    {
      "branch": "next",
      "prerelease": true,
      "prerelease-type": "preview"
    }
  ]
}
